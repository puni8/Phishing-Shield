{
  "manifest_version": 3,
  "name": "Phishing Shield",
  "version": "1.0",
  "description": "Real-time phishing detection with ML and database verification.",
  
  "permissions": [
    "tabs",
    "webNavigation"
  ],

  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "warning.html",
        "warning.css",
        "warning.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "action": {
    "default_title": "Phishing Shield"
  }
}