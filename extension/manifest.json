{
  "manifest_version": 3,
  "name": "Phishing Detection Extension",
  "version": "1.0",
  "description": "Detects phishing websites using ML",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["warning.html", "style.css", "warning.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Phishing Detector"
  }
}
